<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与被测项目同框架：MacroPilot 是 net8.0-windows + WPF，引用它必须对齐 TFM。
         引擎测试不需要 STA；布局探针自行创建并收尾独立 STA 线程。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroPilot\MacroPilot.csproj" />
    <!-- 仅供测试读取生产资源/模板；不会成为本体的发布内容。 -->
    <Content Include="..\MacroPilot\App.xaml" Link="LayoutFixtures\App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\MacroPilot\MainWindow.xaml" Link="LayoutFixtures\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
